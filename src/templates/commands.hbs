<html>
  <body style='min-height:fit-content; height:fit-content'>
    <div style='width: 560px; min-height: 100px;'>
      <table width='100%' style='font-size: 1.7rem;'>
        <tr><th colspan='2'>{{areaName}}</th></tr>
        <tr><td colspan='2'>&nbsp;</td></tr>
        <tr><td align='center'>Producto</td><td
            align='center'
          >Cantidad</td></tr>
        {{#each products}}<tr>
            <td align='center'>{{name}}</td>
            <td align='center'>{{quantity}}</td>
          </tr>
          <tr>
            <td colspan='2'>&nbsp;</td>
          </tr>
          <tr>
            <td colspan='2' align='left'>Comentarios: {{observation}}</td>
          </tr>
        {{/each}}
        <tr>
          <td colspan='2'>&nbsp;</td>
        </tr>
      </table>

      <table width='100%' style='font-size: 1.3rem;'>
        <tbody>
          <tr><td colspan='2'>{{waiter.name}}</td></tr>
        </tbody>
      </table>
    </div>
  </body>
</html>