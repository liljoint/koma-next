<html>
  <body>
    <div style='width: 580px; '>
      <table width='100%' style='font-size: 1.8rem;'>
        <tr><th colspan='3'>{{table.tableName}}</th></tr>
        <tr><td colspan='3'>&nbsp;</td></tr>
        <tr><td align='center'>Producto</td><td align='center'>QTY</td><td
            align='center'
          >Valor</td></tr>
        <tbody>
          {{#each orders}}<tr>
              <td>{{short product.productName}}
                <span style='font-size: 1.5rem; padding-left: 1rem'>$
                  {{format unitPrice}}</span></td>
              <td align='center'>{{quantity}}</td>
              <td align='right'>$ {{format totalPrice}}</td>
            </tr>{{/each}}
          <tr>
            <td colspan='3'>&nbsp;</td>
          </tr>

          <tr>
            <td colspan='2'>Sub Total:</td><td align='right'>$
              {{format totalAmount}}</td>
          </tr>
          <tr>
            <td colspan='2'>Propina Sugerida (10%):</td>
            <td align='right'>$ {{format tip}}</td>
          </tr>
          <tr>
            <td colspan='3'>&nbsp;</td>
          </tr>
          <tr>
            <td colspan='2'>Total a pagar:</td><td align='right'>$
              {{format detailTotal}}</td>
          </tr>

          <tr>
            <td colspan='3'>&nbsp;</td>
          </tr>
          <tr>
            <td colspan='3'>&nbsp;</td>
          </tr>
          <tr>
            <td colspan='3' align='right'>{{now ''}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </body>
</html>